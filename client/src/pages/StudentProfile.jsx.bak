import {useEffect,useState} from 'react';import {useNavigate,useParams} from 'react-router-dom';import api from '../services/api';import {Page,Card,KPI,Button,Table,money} from '../components/UI';import {useAuth} from '../context/Auth';
export default function StudentProfile(){const{id}=useParams(),nav=useNavigate(),{hostel}=useAuth(),[d,setD]=useState(null),[error,setError]=useState('');const load=()=>api.get('/students/'+id).then(r=>setD(r.data)).catch(e=>setError(e.response?.data?.message||e.message));useEffect(load,[id]);if(error)return <Page title="Student"><Card>{error}</Card></Page>;if(!d)return <Page title="Student"><Card>Loading…</Card></Page>;const s=d.student,out=d.invoices.reduce((a,x)=>a+Number(x.balance?.$numberDecimal||x.balance||0),0);const checkout=async()=>{const reason=prompt('Checkout reason');if(reason===null)return;try{await api.post(`/students/${id}/checkout`,{reason});await load()}catch(e){if(e.response?.status===409&&confirm(`${e.response.data.message}\n\nForce checkout anyway?`)){await api.post(`/students/${id}/checkout`,{reason,force:true});await load()}else setError(e.response?.data?.message||e.message)}};return <Page title={s.name} subtitle={`${s.studentCode} · ${s.status}`}><div className="grid gap-3 md:grid-cols-4"><KPI label="Monthly fee" value={money(s.monthlyFee?.$numberDecimal||s.monthlyFee,hostel.currency)}/><KPI label="Outstanding" value={money(out,hostel.currency)}/><KPI label="Phone" value={s.phone}/><KPI label="Admission" value={new Date(s.admissionDate).toLocaleDateString()}/></div><div className="mt-4 grid gap-4 lg:grid-cols-2"><Card title="Personal & Guardian"><div className="space-y-2 text-sm"><p><b>Permanent address:</b> {s.address?.permanent||'—'}</p><p><b>Current address:</b> {s.address?.current||'—'}</p><p><b>Parent/guardian:</b> {s.guardian?.name||'—'} · {s.guardian?.phone||'—'}</p><p><b>Local guardian:</b> {s.localGuardian?.name||'—'} · {s.localGuardian?.phone||'—'}</p><p><b>Institution:</b> {s.academic?.institution||'—'} {s.academic?.course||''}</p></div></Card><Card title="Documents">{!d.documents?.length?<p className="text-sm text-slate-500">No documents uploaded.</p>:<div className="space-y-2">{d.documents.map(x=><div className="rounded-xl border p-3 text-sm" key={x._id}><b className="capitalize">{x.type.replaceAll('_',' ')}</b> · {x.side}<div className="text-xs text-slate-500">{x.number||'No document number'}</div></div>)}</div>}</Card></div><Card title="Invoices"><Table heads={['Period','Total','Paid','Balance','Status']}>{d.invoices.map(i=><tr key={i._id}><td className="p-3">{i.periodKey}</td><td className="p-3">{money(i.total?.$numberDecimal||i.total,i.currency)}</td><td className="p-3">{money(i.paid?.$numberDecimal||i.paid,i.currency)}</td><td className="p-3">{money(i.balance?.$numberDecimal||i.balance,i.currency)}</td><td className="p-3 capitalize">{i.status}</td></tr>)}</Table></Card>{s.status!=='checked_out'&&<div className="mt-4"><Button onClick={checkout}>Checkout Student</Button></div>}</Page>}
