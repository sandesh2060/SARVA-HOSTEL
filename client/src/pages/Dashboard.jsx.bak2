import { useCallback, useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../services/api';
import { onDashboardChange } from '../utils/dashboardBus';
import { Page, Card, KPI, Button, Badge, Empty, Skeleton, Select, Input, Table, money } from '../components/UI';
import { useAuth } from '../context/Auth';
import { Users, Wallet, ReceiptText, PackageSearch, BedDouble, RefreshCw, AlertTriangle, TrendingUp, TrendingDown, Building2, ClipboardList, UserPlus, CreditCard, Boxes, Bell } from 'lucide-react';
import {
  ResponsiveContainer,
  LineChart,
  Line,
  CartesianGrid,
  XAxis,
  YAxis,
  Tooltip,
  Legend,
  PieChart,
  Pie,
  Cell,
} from 'recharts';

const PIE_COLORS = ['#0f766e', '#d97706', '#2563eb', '#dc2626', '#7c3aed'];
const PERIODS = [
  ['this_month', 'This month'],
  ['today', 'Today'],
  ['yesterday', 'Yesterday'],
  ['this_week', 'This week'],
  ['last_month', 'Last month'],
  ['this_year', 'This year'],
  ['custom', 'Custom range'],
];

function greetingFor(date) {
  const h = date.getHours();
  if (h < 12) return 'Good morning';
  if (h < 17) return 'Good afternoon';
  return 'Good evening';
}

function StatusBadge({ status }) {
  const map = {
    overdue: ['danger', 'Overdue'],
    due_today: ['warning', 'Due today'],
    due_soon: ['muted', 'Due soon'],
    scheduled: ['muted', 'Scheduled'],
  };
  const [tone, label] = map[status] || ['muted', status];
  return <Badge tone={tone}>{label}</Badge>;
}

export default function Dashboard() {
  const { user, hostel } = useAuth();
  const navigate = useNavigate();
  const [period, setPeriod] = useState('this_month');
  const [from, setFrom] = useState('');
  const [to, setTo] = useState('');
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const load = useCallback(async () => {
    setLoading(true);
    setError('');
    try {
      const params = { period };
      if (period === 'custom') {
        if (!from || !to) {
          setLoading(false);
          return;
        }
        params.from = from;
        params.to = to;
      }
      const { data: res } = await api.get('/dashboard/summary', { params });
      setData(res.data);
    } catch (e) {
      setError(e.response?.data?.message || e.message);
    } finally {
      setLoading(false);
    }
  }, [period, from, to]);

  useEffect(() => {
    load();
  }, [load]);

  useEffect(() => onDashboardChange(load), [load]);

  const cur = data?.currency || hostel?.currency || 'NPR';
  const caps = hostel?.capabilities || [];
  const has = (c) => caps.includes(c);

  const chartData = (data?.finance?.trend || []).map((t) => ({ label: t.key, Collected: t.collected, Expenses: t.expenses }));
  const methods = data?.finance?.paymentMethods || [];

  return (
    <div className="animate-fade-in space-y-6">
      {/* Header */}
      <div className="flex flex-col gap-4 border-b border-sarva-border pb-5 lg:flex-row lg:items-center lg:justify-between">
        <div className="space-y-1">
          <div className="flex items-center gap-2">
            <h1 className="text-2xl font-bold tracking-tight text-sarva-text">
              {greetingFor(new Date())}, {user?.name || 'Owner'}
            </h1>
            {hostel?.plan && (
              <Badge variant="outline" className="text-[10px] uppercase tracking-wide">
                {hostel.plan}
              </Badge>
            )}
          </div>
          <p className="text-sm text-sarva-muted">
            {hostel?.name}
            {' · '}
            {new Date().toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <div className="flex items-center gap-2 rounded-lg border border-sarva-border bg-sarva-surface px-2 py-1">
            <Select
              value={period}
              onChange={(e) => setPeriod(e.target.value)}
              className="w-auto border-none bg-transparent shadow-none focus:ring-0"
            >
              {PERIODS.map(([v, l]) => (
                <option key={v} value={v}>
                  {l}
                </option>
              ))}
            </Select>
            {period === 'custom' && (
              <>
                <Input type="date" value={from} onChange={(e) => setFrom(e.target.value)} className="w-auto" />
                <span className="text-xs text-sarva-muted">to</span>
                <Input type="date" value={to} onChange={(e) => setTo(e.target.value)} className="w-auto" />
                <Button size="sm" onClick={load}>Apply</Button>
              </>
            )}
          </div>

          <Button
            variant="ghost"
            onClick={load}
            disabled={loading}
            className="border border-sarva-border"
            title="Refresh dashboard"
          >
            <RefreshCw size={16} className={loading ? 'animate-spin' : ''} />
            <span className="hidden sm:inline">Refresh</span>
          </Button>

          <Button variant="ghost" className="relative border border-sarva-border" title="Notifications">
            <Bell size={16} />
            {Array.isArray(data?.alerts) && data.alerts.length > 0 && (
              <span className="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-sarva-danger text-[10px] text-white">
                {data.alerts.length}
              </span>
            )}
          </Button>
        </div>
      </div>

      {error && (
        <Card className="mt-4">
          <p className="text-sarva-danger">{error}</p>
          <Button className="mt-3" variant="ghost" onClick={load}>
            Retry
          </Button>
        </Card>
      )}

      {loading && !data && (
        <div className="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {Array.from({ length: 8 }).map((_, i) => (
            <Skeleton key={i} className="h-24 w-full" />
          ))}
        </div>
      )}

      {!error && data && (
        <>
          {/* KPI cards */}
          <div className="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div onClick={() => navigate('/students')} className="cursor-pointer">
              <KPI
                icon={Users}
                label="Active students"
                value={data.students.active}
                help={data.students.admittedInPeriod ? `+${data.students.admittedInPeriod} this period` : 'No new admissions this period'}
              />
            </div>
            {data.occupancy && (
              <div onClick={() => navigate('/rooms')} className="cursor-pointer">
                <KPI
                  icon={Building2}
                  label="Occupancy"
                  value={`${data.occupancy.occupancyPct}%`}
                  help={`${data.occupancy.occupied} / ${data.occupancy.totalBeds} beds occupied`}
                />
              </div>
            )}
            {data.occupancy && (
              <div onClick={() => navigate('/rooms')} className="cursor-pointer">
                <KPI
                  icon={BedDouble}
                  label="Available beds"
                  value={data.occupancy.available}
                  help={`${data.occupancy.roomsWithAvailability} room(s) have availability`}
                />
              </div>
            )}
            <div onClick={() => navigate('/payments')} className="cursor-pointer">
              <KPI
                icon={Wallet}
                label="Collected"
                value={money(data.finance.collected, cur)}
                help={
                  data.finance.collectedChangePct === null
                    ? undefined
                    : `${data.finance.collectedChangePct >= 0 ? '+' : ''}${data.finance.collectedChangePct}% vs previous period`
                }
              />
            </div>
            <div onClick={() => navigate('/credits')} className="cursor-pointer">
              <KPI
                icon={CreditCard}
                label="Outstanding"
                value={money(data.finance.outstanding, cur)}
                help={`${data.finance.outstandingStudents} student(s)`}
              />
            </div>
            <div onClick={() => navigate('/expenses')} className="cursor-pointer">
              <KPI
                icon={ReceiptText}
                label="Expenses"
                value={money(data.finance.expenses, cur)}
                help={data.finance.expenseByCategory?.[0] ? `Top: ${data.finance.expenseByCategory[0].category}` : undefined}
              />
            </div>
            <KPI icon={TrendingUp} label="Net operational amount" value={money(data.finance.net, cur)} help="Collected − Expenses (this period)" />
            <div onClick={() => navigate('/stock')} className="cursor-pointer">
              <KPI icon={Boxes} label="Low stock" value={data.stock.low || 'Stock healthy'} help={data.stock.outOfStock ? `${data.stock.outOfStock} out of stock` : undefined} />
            </div>
          </div>

          {/* Needs attention */}
          <Card title="Needs your attention" className="mt-6">
            {!data.alerts.length ? (
              <Empty>Nothing needs your attention right now.</Empty>
            ) : (
              <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                {data.alerts.map((a) => (
                  <div key={a.type} className="flex items-start justify-between gap-3 rounded-xl border border-sarva-border p-3">
                    <div>
                      <div className="flex items-center gap-2 text-sm font-semibold text-sarva-text">
                        <AlertTriangle size={14} className="text-sarva-warning" /> {a.title}
                      </div>
                      <p className="mt-1 text-xs text-sarva-muted">{a.detail}</p>
                    </div>
                    <Button variant="ghost" className="shrink-0 px-3 py-1.5 text-xs" onClick={() => navigate(a.action.to)}>
                      {a.action.label}
                    </Button>
                  </div>
                ))}
              </div>
            )}
          </Card>

          {/* Quick actions */}
          <Card title="Quick actions" className="mt-6">
            <div className="flex flex-wrap gap-2">
              <Button variant="ghost" onClick={() => navigate('/students')}>
                <UserPlus size={16} /> Register student
              </Button>
              <Button variant="ghost" onClick={() => navigate('/payments')}>
                <Wallet size={16} /> Collect payment
              </Button>
              <Button variant="ghost" onClick={() => navigate('/expenses')}>
                <ReceiptText size={16} /> Add expense
              </Button>
              <Button variant="ghost" onClick={() => navigate('/stock')}>
                <Boxes size={16} /> Stock in / out
              </Button>
              {data.occupancy && (
                <Button variant="ghost" onClick={() => navigate('/rooms')}>
                  <BedDouble size={16} /> Assign room
                </Button>
              )}
              {data.attendance && (
                <Button variant="ghost" onClick={() => navigate('/attendance')}>
                  <ClipboardList size={16} /> Take attendance
                </Button>
              )}
              {data.staff && (
                <Button variant="ghost" onClick={() => navigate('/staff')}>
                  <Users size={16} /> Add staff
                </Button>
              )}
              {has('broadcast') && (
                <Button variant="ghost" onClick={() => navigate('/broadcast')}>
                  Send broadcast
                </Button>
              )}
            </div>
          </Card>

          {/* Charts */}
          <div className="mt-6 grid gap-4 xl:grid-cols-3">
            <Card title="Payment collection" className="xl:col-span-2">
              {!chartData.some((d) => d.Collected) ? (
                <Empty>No payments recorded for this period.</Empty>
              ) : (
                <div style={{ width: '100%', height: 260 }}>
                  <ResponsiveContainer>
                    <LineChart data={chartData}>
                      <CartesianGrid strokeDasharray="3 3" stroke="var(--sarva-border)" />
                      <XAxis dataKey="label" tick={{ fontSize: 11 }} />
                      <YAxis tick={{ fontSize: 11 }} />
                      <Tooltip formatter={(v) => money(v, cur)} />
                      <Line type="monotone" dataKey="Collected" stroke="#0f766e" strokeWidth={2} dot={false} />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              )}
            </Card>
            <Card title="Payment methods">
              {!methods.length ? (
                <Empty>No confirmed payments yet.</Empty>
              ) : (
                <>
                  <div style={{ width: '100%', height: 180 }}>
                    <ResponsiveContainer>
                      <PieChart>
                        <Pie data={methods} dataKey="total" nameKey="method" innerRadius={40} outerRadius={70} paddingAngle={2}>
                          {methods.map((m, i) => (
                            <Cell key={m.method} fill={PIE_COLORS[i % PIE_COLORS.length]} />
                          ))}
                        </Pie>
                        <Tooltip formatter={(v) => money(v, cur)} />
                      </PieChart>
                    </ResponsiveContainer>
                  </div>
                  <div className="mt-2 space-y-1 text-xs">
                    {methods.map((m, i) => (
                      <div key={m.method} className="flex items-center justify-between">
                        <span className="flex items-center gap-2 capitalize">
                          <span className="h-2 w-2 rounded-full" style={{ background: PIE_COLORS[i % PIE_COLORS.length] }} />
                          {m.method.replaceAll('_', ' ')}
                        </span>
                        <span>
                          {money(m.total, cur)} · {m.pct}%
                        </span>
                      </div>
                    ))}
                  </div>
                </>
              )}
            </Card>
          </div>

          <Card title="Collections vs expenses" className="mt-6">
            {!chartData.length ? (
              <Empty>No financial activity for this period.</Empty>
            ) : (
              <div style={{ width: '100%', height: 260 }}>
                <ResponsiveContainer>
                  <LineChart data={chartData}>
                    <CartesianGrid strokeDasharray="3 3" stroke="var(--sarva-border)" />
                    <XAxis dataKey="label" tick={{ fontSize: 11 }} />
                    <YAxis tick={{ fontSize: 11 }} />
                    <Tooltip formatter={(v) => money(v, cur)} />
                    <Legend />
                    <Line type="monotone" dataKey="Collected" stroke="#0f766e" strokeWidth={2} dot={false} />
                    <Line type="monotone" dataKey="Expenses" stroke="#dc2626" strokeWidth={2} dot={false} />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            )}
          </Card>

          {/* Upcoming & overdue */}
          <div className="mt-6 grid gap-4 xl:grid-cols-2">
            <Card title="Upcoming payments" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/credits')}>View all</Button>}>
              {!data.upcomingPayments.length ? (
                <Empty>No upcoming payments.</Empty>
              ) : (
                <Table heads={['Student', 'Due', 'Amount', 'Status', '']}>
                  {data.upcomingPayments.map((p) => (
                    <tr key={p.invoiceId}>
                      <td className="p-3">
                        {p.student?.name || '—'}
                        <div className="text-xs text-sarva-muted">{p.student?.studentCode}</div>
                      </td>
                      <td className="p-3">{p.dueDate ? new Date(p.dueDate).toLocaleDateString() : '—'}</td>
                      <td className="p-3 font-semibold">{money(p.balance, p.currency || cur)}</td>
                      <td className="p-3">
                        <StatusBadge status={p.status} />
                      </td>
                      <td className="p-3">
                        <Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/payments')}>
                          Collect
                        </Button>
                      </td>
                    </tr>
                  ))}
                </Table>
              )}
            </Card>

            <Card title="Overdue students" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/credits')}>View all overdue</Button>}>
              {!data.overdueStudents.length ? (
                <Empty>No overdue payments.</Empty>
              ) : (
                <Table heads={['Student', 'Oldest due', 'Days', 'Outstanding', '']}>
                  {data.overdueStudents.map((s) => (
                    <tr key={s.invoiceId}>
                      <td className="p-3">
                        {s.student?.name || '—'}
                        <div className="text-xs text-sarva-muted">{s.student?.phone}</div>
                      </td>
                      <td className="p-3">{s.oldestDue ? new Date(s.oldestDue).toLocaleDateString() : '—'}</td>
                      <td className="p-3">
                        <Badge tone="danger">{s.daysOverdue}d</Badge>
                      </td>
                      <td className="p-3 font-semibold">{money(s.outstanding, s.currency || cur)}</td>
                      <td className="p-3">
                        <Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/credits')}>
                          Collect
                        </Button>
                      </td>
                    </tr>
                  ))}
                </Table>
              )}
            </Card>
          </div>

          {/* Room occupancy + credit snapshot */}
          <div className="mt-6 grid gap-4 xl:grid-cols-2">
            {data.occupancy && (
              <Card title="Room occupancy">
                <div className="mb-3 flex gap-4 text-sm">
                  <span>
                    <b>{data.occupancy.occupied}</b> occupied
                  </span>
                  <span>
                    <b>{data.occupancy.available}</b> available
                  </span>
                  <span>
                    <b>{data.occupancy.maintenance}</b> maintenance
                  </span>
                </div>
                {!data.rooms.length ? (
                  <Empty>No rooms configured yet.</Empty>
                ) : (
                  <div className="grid gap-2 sm:grid-cols-2">
                    {data.rooms.slice(0, 8).map((r) => (
                      <button
                        key={r.id}
                        onClick={() => navigate('/rooms')}
                        className="rounded-xl border border-sarva-border p-3 text-left text-sm hover:bg-sarva-primarySoft/40"
                      >
                        <div className="font-semibold">{r.name}</div>
                        <div className="text-xs text-sarva-muted">
                          {r.occupied} / {r.capacity} ·{' '}
                          {r.status === 'full' ? 'FULL' : r.status === 'empty' ? 'EMPTY' : r.status === 'no_beds' ? 'NO BEDS' : `${r.capacity - r.occupied} AVAILABLE`}
                        </div>
                      </button>
                    ))}
                  </div>
                )}
              </Card>
            )}

            <Card title="Credit snapshot" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/credits')}>Open credits</Button>}>
              <div className="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
                <div>
                  <div className="text-xs text-sarva-muted">Outstanding</div>
                  <div className="font-semibold">{money(data.credit.outstanding, cur)}</div>
                </div>
                <div>
                  <div className="text-xs text-sarva-muted">Overdue</div>
                  <div className="font-semibold">{money(data.credit.overdue, cur)}</div>
                </div>
                <div>
                  <div className="text-xs text-sarva-muted">Students</div>
                  <div className="font-semibold">{data.credit.studentsWithCredit}</div>
                </div>
              </div>
              <div className="mt-4 space-y-1 text-xs">
                {[
                  ['Current', data.credit.aging.current],
                  ['1–30 days', data.credit.aging.d1_30],
                  ['31–60 days', data.credit.aging.d31_60],
                  ['61–90 days', data.credit.aging.d61_90],
                  ['90+ days', data.credit.aging.d90plus],
                ].map(([label, val]) => (
                  <div key={label} className="flex items-center justify-between">
                    <span>{label}</span>
                    <span className="font-medium">{money(val, cur)}</span>
                  </div>
                ))}
              </div>
            </Card>
          </div>

          {/* Recent payments + admissions */}
          <div className="mt-6 grid gap-4 xl:grid-cols-2">
            <Card title="Recent payments">
              {!data.recentPayments.length ? (
                <Empty>No payments recorded yet.</Empty>
              ) : (
                <div className="space-y-2">
                  {data.recentPayments.map((p) => (
                    <div key={p.id} className="flex items-center justify-between rounded-xl border border-sarva-border p-3 text-sm">
                      <div>
                        <div className="font-medium">{p.student?.name || 'Student'}</div>
                        <div className="text-xs capitalize text-sarva-muted">
                          {p.method?.replaceAll('_', ' ')} · {new Date(p.createdAt).toLocaleString()}
                        </div>
                      </div>
                      <div className="text-right">
                        <div className={p.status === 'reversed' ? 'font-semibold text-sarva-danger line-through' : 'font-semibold'}>
                          {money(p.amount, p.currency || cur)}
                        </div>
                        {p.status === 'reversed' ? (
                          <Badge tone="danger">Reversed</Badge>
                        ) : (
                          <button className="text-xs text-sarva-primary underline" onClick={() => navigate(`/payments/${p.id}/receipt`)}>
                            Receipt
                          </button>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </Card>

            <Card title="Recent admissions" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/students')}>View all students</Button>}>
              {!data.recentAdmissions.length ? (
                <Empty>No students registered yet.</Empty>
              ) : (
                <div className="space-y-2">
                  {data.recentAdmissions.map((s) => (
                    <button
                      key={s._id}
                      onClick={() => navigate(`/students/${s._id}`)}
                      className="flex w-full items-center gap-3 rounded-xl border border-sarva-border p-2.5 text-left text-sm hover:bg-sarva-primarySoft/40"
                    >
                      {s.photo?.url ? (
                        <img src={s.photo.url} className="h-9 w-9 rounded-full object-cover" alt="" />
                      ) : (
                        <span className="flex h-9 w-9 items-center justify-center rounded-full bg-sarva-primarySoft text-xs font-semibold text-sarva-primary">
                          {s.name?.[0]?.toUpperCase() || '?'}
                        </span>
                      )}
                      <div className="flex-1">
                        <div className="font-medium">{s.name}</div>
                        <div className="text-xs text-sarva-muted">
                          {s.studentCode} · {new Date(s.admissionDate).toLocaleDateString()}
                        </div>
                      </div>
                      <div className="text-xs font-semibold">{money(s.monthlyFee?.$numberDecimal ?? s.monthlyFee, cur)}</div>
                    </button>
                  ))}
                </div>
              )}
            </Card>
          </div>

          {/* Expenses + Low stock */}
          <div className="mt-6 grid gap-4 xl:grid-cols-2">
            <Card title="Expenses" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/expenses')}>View expenses</Button>}>
              <div className="mb-3 text-2xl font-bold">{money(data.finance.expenses, cur)}</div>
              {!data.finance.expenseByCategory.length ? (
                <Empty>No expenses recorded for this period.</Empty>
              ) : (
                <div className="space-y-1 text-sm">
                  {data.finance.expenseByCategory.slice(0, 6).map((c) => (
                    <div key={c.category} className="flex items-center justify-between">
                      <span>{c.category}</span>
                      <span className="font-medium">{money(c.total, cur)}</span>
                    </div>
                  ))}
                </div>
              )}
            </Card>

            <Card title="Low stock" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/stock')}>Stock in</Button>}>
              {!data.stock.items.length ? (
                <Empty>All stock levels are healthy.</Empty>
              ) : (
                <Table heads={['Item', 'Qty', 'Minimum', 'Status']}>
                  {data.stock.items.map((s) => (
                    <tr key={s.id}>
                      <td className="p-3">{s.name}</td>
                      <td className="p-3">
                        {s.quantity} {s.unit}
                      </td>
                      <td className="p-3">
                        {s.minimumQuantity} {s.unit}
                      </td>
                      <td className="p-3">
                        <Badge tone={s.quantity <= 0 ? 'danger' : 'warning'}>{s.quantity <= 0 ? 'Out of stock' : 'Low'}</Badge>
                      </td>
                    </tr>
                  ))}
                </Table>
              )}
            </Card>
          </div>

          {/* Attendance + staff/salary */}
          {(data.attendance || data.staff) && (
            <div className="mt-6 grid gap-4 xl:grid-cols-2">
              {data.attendance && (
                <Card title="Today's attendance" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/attendance')}>Take attendance</Button>}>
                  <div className="grid grid-cols-3 gap-3 text-center text-sm sm:grid-cols-5">
                    {[
                      ['Present', data.attendance.present],
                      ['Absent', data.attendance.absent],
                      ['Late', data.attendance.late],
                      ['Leave', data.attendance.leave],
                      ['Not recorded', data.attendance.notRecorded],
                    ].map(([label, val]) => (
                      <div key={label} className="rounded-xl border border-sarva-border p-2">
                        <div className="text-lg font-bold">{val}</div>
                        <div className="text-xs text-sarva-muted">{label}</div>
                      </div>
                    ))}
                  </div>
                </Card>
              )}
              {data.staff && (
                <Card title="Staff & salary" action={<Button variant="ghost" className="px-3 py-1.5 text-xs" onClick={() => navigate('/salary')}>Manage salary</Button>}>
                  <div className="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
                    <div>
                      <div className="text-xs text-sarva-muted">Active staff</div>
                      <div className="font-semibold">{data.staff.activeStaff}</div>
                    </div>
                    <div>
                      <div className="text-xs text-sarva-muted">Paid this month</div>
                      <div className="font-semibold">{money(data.staff.paidThisMonth, cur)}</div>
                    </div>
                    <div>
                      <div className="text-xs text-sarva-muted">Remaining</div>
                      <div className="font-semibold">{money(data.staff.remaining, cur)}</div>
                    </div>
                    <div>
                      <div className="text-xs text-sarva-muted">Pending records</div>
                      <div className="font-semibold">{data.staff.pendingRecords}</div>
                    </div>
                  </div>
                </Card>
              )}
            </div>
          )}

          {/* Recent activity */}
          <Card title="Recent activity" className="mt-6">
            {!data.recentActivity.length ? (
              <Empty>No recent activity.</Empty>
            ) : (
              <div className="space-y-2 text-sm">
                {data.recentActivity.map((a) => (
                  <div key={a.id} className="flex items-center justify-between border-b border-dashed border-sarva-border py-1.5 last:border-0">
                    <span className="capitalize">{a.label.replaceAll('_', ' ').replaceAll('.', ' · ')}</span>
                    <span className="text-xs text-sarva-muted">{new Date(a.createdAt).toLocaleString()}</span>
                  </div>
                ))}
              </div>
            )}
          </Card>
        </>
      )}
    </div>
  );
}