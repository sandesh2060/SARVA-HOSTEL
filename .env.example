# Server
NODE_ENV=development
PORT=4000
HOSTEL_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/sarva_hostel
JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SARVA_ADMIN_URL=http://localhost:5176
SARVA_INTEGRATION_SECRET=replace_with_shared_service_secret

# Cloudinary - dedicated SARVA Hostel configuration
HOSTEL_CLOUDINARY_CLOUD_NAME=
HOSTEL_CLOUDINARY_API_KEY=
HOSTEL_CLOUDINARY_API_SECRET=
HOSTEL_CLOUDINARY_ROOT=sarva-hostel

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SARVA Hostel <no-reply@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID=

# eSewa - configure sandbox/production values later
ESEWA_ENABLED=false
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
